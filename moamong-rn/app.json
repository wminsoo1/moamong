{
  "expo": {
    "name": "모아몽",
    "slug": "moamong",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": ["moamong", "kakaof481347e0578b734ef7deee10b002433"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.moamong.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        },
        "NSPhotoLibraryUsageDescription": "지출 내역에 사진을 첨부해 가계부를 기록하기 위해 사용합니다.",
        "NSCameraUsageDescription": "공유할 아이템 사진을 촬영하기 위해 사용합니다.",
        "CFBundleLocalizations": ["ko", "en"],
        "KAKAO_APP_KEY": "f481347e0578b734ef7deee10b002433",
        "LSApplicationQueriesSchemes": ["kakaokompassauth", "storekvault"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "notification": {
      "iosDisplayInForeground": true
    },
    "android": {
      "package": "com.moamong.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      "expo-apple-authentication",
      "@react-native-firebase/app",
      [
        "expo-notifications",
        {
          "iosDisplayInForeground": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
